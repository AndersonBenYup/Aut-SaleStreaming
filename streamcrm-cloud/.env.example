# ---------- General ----------
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# Vacío en desarrollo = Postgres 16 embebido (apps/api/.pgdata). En producción es obligatorio.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/streamcrm
DATABASE_URL=

# Clave AES-256-GCM para contraseñas, PIN y tokens (64 caracteres hex).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------- Recordatorios ----------
# "console" = nunca llama ni escribe de verdad, solo muestra en la consola. Recomendado al empezar.
REMINDER_CHANNEL_OVERRIDE=console
# Fuera de producción solo se llama de verdad a estos números (E.164, separados por coma). Ej: +51987000000
DEV_ALLOWED_NUMBERS=

# ---------- Retell AI ----------
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# ---------- WhatsApp Cloud API ----------
WHATSAPP_VERIFY_TOKEN=streamcrm-verify
WHATSAPP_APP_SECRET=

# ---------- Vendedor por WhatsApp con IA ----------
# 'anthropic' (recomendado para producción, de pago) o 'openrouter' (modelos gratis, para probar).
# Sin clave para el proveedor elegido el bot no responde y los mensajes se interpretan por palabras
# como antes. El vendedor se enciende por negocio en Ajustes.
SALES_AGENT_PROVIDER=anthropic
# Clave de la API de Claude (console.anthropic.com). Solo si SALES_AGENT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Clave de OpenRouter (openrouter.ai/settings/keys). Solo si SALES_AGENT_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Con 'anthropic': claude-haiku-5-5 (el más barato, recomendado) o claude-sonnet-5-5 si quieres más calidad.
# Con 'openrouter': openrouter/free (elige automáticamente un modelo gratis que sirva para la conversación),
# o un id fijo como nvidia/nemotron-3-ultra-550b-a55b:free / nvidia/nemotron-3.5-lightning:free.
SALES_AGENT_MODEL=claude-haiku-5-5

# ---------- Google Sheets ----------
# Contenido JSON completo de la service account, o la ruta al archivo .json.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Cada cuánto se escanean las hojas (cron, UTC).
SHEET_SCAN_CRON=*/15 * * * *
# Una fila pasa de la hoja a la BD cuando su recordatorio cae dentro de estas horas (o ya venció).
SHEET_IMPORT_WINDOW_HOURS=48
