{
  "name": "streamcrm-cloud",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @streamcrm/api",
    "dev:web": "npm run dev -w @streamcrm/web",
    "build": "npm run build -w @streamcrm/shared && npm run build -w @streamcrm/api && npm run build -w @streamcrm/web",
    "test": "npm run test -w @streamcrm/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w @streamcrm/api",
    "seed": "npm run seed -w @streamcrm/api",
    "create-superadmin": "npm run create-superadmin -w @streamcrm/api",
    "demo:sheet": "npm run demo:sheet -w @streamcrm/api",
    "vendedor:chat": "npm run vendedor:chat -w @streamcrm/api"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@16.14.0-beta.17": true
  }
}
