# StreamCRM crea .env solo en el primer arranque. Este archivo es solo de referencia.
ENCRYPTION_KEY=      # 64 hex. Cifra contraseñas, PIN y tokens. ¡No la pierdas ni la cambies!
SESSION_SECRET=      # 64 hex. Firma las sesiones.
PORT=3000
HOST=127.0.0.1       # 0.0.0.0 para entrar desde el celular en la misma red (Ajustes → Webhook y red)
# DATA_DIR=data
# BACKUP_DIR=backups
# CLOUDFLARE_TUNNEL_TOKEN=   # túnel con nombre (dominio fijo) para el webhook de Retell
# REMINDER_CHANNEL_OVERRIDE=console   # pruebas: no llama a nadie, solo imprime
